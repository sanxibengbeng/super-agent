        <mxCell id="security-title" value="&lt;b&gt;Security Posture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="80" y="945" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="security-content" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Network&lt;/b&gt;&lt;br&gt;• No 0.0.0.0/0 ingress&lt;br&gt;• VPC Origin (private path)&lt;br&gt;• VPC Flow Logs enabled&lt;br&gt;• 7 VPC Endpoints&lt;br&gt;&lt;br&gt;&lt;b&gt;IAM&lt;/b&gt;&lt;br&gt;• Least-privilege S3 actions&lt;br&gt;• SourceAccount conditions&lt;br&gt;• No s3:* / bedrock:* wildcards&lt;br&gt;&lt;br&gt;&lt;b&gt;Encryption&lt;/b&gt;&lt;br&gt;• TLS 1.2+ everywhere&lt;br&gt;• Redis TLS: required&lt;br&gt;• Redis AUTH token&lt;br&gt;• S3 enforceSSL: true&lt;br&gt;• RDS encrypted at rest&lt;br&gt;&lt;br&gt;&lt;b&gt;WAF&lt;/b&gt;&lt;br&gt;• Rate limit: 1000/5min&lt;br&gt;• AWS CRS + SQLi&lt;br&gt;• KnownBadInputs&lt;br&gt;• IP Reputation List&lt;br&gt;&lt;br&gt;&lt;b&gt;Reliability&lt;/b&gt;&lt;br&gt;• Circuit breaker + rollback&lt;br&gt;• Graceful shutdown 120s&lt;br&gt;• Multi-AZ (all layers)&lt;br&gt;• Log retention: 90 days&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="70" y="970" width="195" height="340" as="geometry" />
        </mxCell>

