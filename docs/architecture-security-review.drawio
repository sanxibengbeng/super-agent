                    <mxGeometry x="1490" y="1002.5" width="360" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="integration-title" value="&lt;b&gt;Bedrock Integration Patterns&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=11;fontColor=#7F6000;" parent="1" vertex="1">
                    <mxGeometry x="1520" y="855" width="250" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="integration-content" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Path 1: Direct Model Invocation&lt;/b&gt;&lt;br&gt;ECS Tasks → Bedrock VPC Endpoint → Models&lt;br&gt;• Chat streaming (API Service)&lt;br&gt;• Workflow node execution (Worker)&lt;br&gt;• CLAUDE_CODE_USE_BEDROCK=1&lt;br&gt;&lt;br&gt;&lt;b&gt;Path 2: AgentCore Runtime&lt;/b&gt;&lt;br&gt;Worker → AgentCore API → microVM&lt;br&gt;• Isolated container (ARM64/ECR)&lt;br&gt;• Claude Agent SDK inside microVM&lt;br&gt;• S3 Files mount (shared workspace)&lt;br&gt;• Session affinity (sticky microVM)&lt;br&gt;&lt;br&gt;&lt;b&gt;IAM &amp; Security:&lt;/b&gt;&lt;br&gt;• SourceAccount confused deputy guard&lt;br&gt;• Scoped: anthropic.* models only&lt;br&gt;• Cross-region inference profiles&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=3;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="1020" width="340" height="195" as="geometry"/>
                </mxCell>
                <mxCell id="security-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="60" y="940" width="210" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="security-title" value="&lt;b&gt;Security Posture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#2D7600;" parent="1" vertex="1">
                    <mxGeometry x="80" y="945" width="150" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="security-content" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Network&lt;/b&gt;&lt;br&gt;• No 0.0.0.0/0 ingress&lt;br&gt;• VPC Origin (private path)&lt;br&gt;• VPC Flow Logs enabled&lt;br&gt;• 7 VPC Endpoints&lt;br&gt;&lt;br&gt;&lt;b&gt;IAM&lt;/b&gt;&lt;br&gt;• Least-privilege S3 actions&lt;br&gt;• SourceAccount conditions&lt;br&gt;• No s3:* / bedrock:* wildcards&lt;br&gt;&lt;br&gt;&lt;b&gt;Encryption&lt;/b&gt;&lt;br&gt;• TLS 1.2+ everywhere&lt;br&gt;• Redis TLS: required&lt;br&gt;• Redis AUTH token&lt;br&gt;• S3 enforceSSL: true&lt;br&gt;• RDS encrypted at rest&lt;br&gt;&lt;br&gt;&lt;b&gt;WAF&lt;/b&gt;&lt;br&gt;• Rate limit: 1000/5min&lt;br&gt;• AWS CRS + SQLi&lt;br&gt;• KnownBadInputs&lt;br&gt;• IP Reputation List&lt;br&gt;&lt;br&gt;&lt;b&gt;Reliability&lt;/b&gt;&lt;br&gt;• Circuit breaker + rollback&lt;br&gt;• Graceful shutdown 120s&lt;br&gt;• Multi-AZ (all layers)&lt;br&gt;• Log retention: 90 days&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=3;" parent="1" vertex="1">
                    <mxGeometry x="70" y="970" width="195" height="340" as="geometry"/>
                </mxCell>
                <mxCell id="runtime-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="480" width="210" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="runtime-title" value="&lt;b&gt;Agent Runtime Factory&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="75" y="485" width="180" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="runtime-content" value="&lt;font style=&quot;font-size:10px&quot;&gt;AGENT_RUNTIME env selects:&lt;br&gt;&lt;br&gt;&lt;b&gt;claude&lt;/b&gt; (default)&lt;br&gt;→ Direct Bedrock streaming&lt;br&gt;→ ECS-local Claude Agent SDK&lt;br&gt;&lt;br&gt;&lt;b&gt;agentcore&lt;/b&gt;&lt;br&gt;→ Remote microVM execution&lt;br&gt;→ Session-sticky containers&lt;br&gt;→ S3 Files workspace mount&lt;br&gt;&lt;br&gt;&lt;b&gt;openclaw&lt;/b&gt;&lt;br&gt;→ OpenClaw adapter&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=10;spacing=3;" parent="1" vertex="1">
                    <mxGeometry x="70" y="510" width="190" height="145" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
