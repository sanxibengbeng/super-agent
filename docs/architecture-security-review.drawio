        <!-- ===== Security Posture Summary ===== -->
        <mxCell id="security-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="940" width="210" height="380" as="geometry" />
